# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=library_app
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Google Books API
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# OCR Provider ('tesseract' or 'easyocr'; see backend/src/services/ocr/)
OCR_PROVIDER=easyocr

# EasyOCR service on Modal - only needed when OCR_PROVIDER=easyocr. Deploy
# with `modal deploy ocr-service/app.py` (see ocr-service/README.md); the
# token must match the value of the `ocr-service-token` Modal secret.
OCR_SERVICE_URL=https://your-workspace--libraryapp-ocr-ocrservice-recognize.modal.run
OCR_SERVICE_TOKEN=your_shared_secret_token

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
