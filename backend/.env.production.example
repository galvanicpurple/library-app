# Production Environment Variables
# Copy this file to .env on your hosting platform and fill in the values

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Get from Railway/Render/Supabase)
DB_HOST=your-database-host.railway.app
DB_PORT=5432
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=your-strong-database-password-here

# JWT Configuration (Generate a strong 64+ character random string)
JWT_SECRET=GENERATE_A_VERY_LONG_RANDOM_STRING_AT_LEAST_64_CHARS_FOR_PRODUCTION
JWT_EXPIRES_IN=7d

# Google Books API
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# CORS Configuration (Your frontend URL)
FRONTEND_URL=https://your-app.vercel.app,https://www.your-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
